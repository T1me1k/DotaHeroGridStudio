{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dota Hero Grid Studio",
  "version": "0.2.0",
  "identifier": "studio.dotaherogrid.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dota Hero Grid Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data: blob:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost 'self' http://127.0.0.1:4173"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
